menu "desk-buddy"

    config BUDDY_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config BUDDY_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config BUDDY_TZ
        string "Timezone (POSIX TZ string)"
        default "<-03>3"
        help
            America/Sao_Paulo is "<-03>3" (UTC-3, no daylight saving).

    config BUDDY_LATITUDE
        string "Latitude for the weather"
        default "-26.4851"
        help
            Default: Jaraguá do Sul, SC.

    config BUDDY_LONGITUDE
        string "Longitude for the weather"
        default "-49.0713"

    config BUDDY_OPEN_METEO_TZ
        string "Timezone name sent to Open-Meteo (URL-encoded)"
        default "America%2FSao_Paulo"

endmenu
